# Cardputer ADV = Stamp-S3A (ESP32-S3FN8: 8 MB flash, no PSRAM)
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"

# USB audio (usb_device_uac): explicit so the code and the host agree
CONFIG_UAC_SAMPLE_RATE=48000
CONFIG_UAC_SPEAKER_CHANNEL_NUM=1
CONFIG_UAC_MIC_CHANNEL_NUM=1

# app_main draws frames; the default 3584 B main task stack is too small
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
